{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.xszc.modules.load": {
      "initial_state": "load",
      "states": {
        "load": {
          "animations": [
            { "mod.init": "q.is_in_ui || v.is_paperdoll" },
            "mod.sharpness_particle",
            "mod.direction_hud"
          ]
        }
      }
    },
    "controller.animation.sharpness_particle": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [{ "hurt": "v.hurt_time" }]
        },
        "hurt": {
          "on_entry": ["v.life_time = q.life_time;"],
          "particle_effects": [
            {
              "effect": "sharpness",
              "locator": "sharpness"
            }
          ],
          "transitions": [{ "default": "q.life_time - v.life_time >= 0.5" }]
        }
      }
    }
  }
}
