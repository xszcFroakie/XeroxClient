{
  "namespace": "xc_modern_hud:modules",

  "armor_hud": {
    "type": "panel",
    "size": [64, 16],
    "offset": "$armor_hud_offset",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "$armor_hud_offset": [42, -40],
    /*"variables": [
      {
        "requires": "((not $zeroday_style_hotbar) or ($zeroday_style_hotbar and $touch))",
        "$armor_hud_offset": [42, -40]
      },
      {
        "requires": "($zeroday_style_hotbar or ((not $zeroday_style_hotbar) and $touch))",
        "$armor_hud_offset": [128, -5]
      }
    ],*/
    "controls": [
      {
        "armor_hud_renderer": {
          "type": "custom",
          "renderer": "live_player_renderer",
          "size": [16, 16],
          "offset": [-24, 485.5]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "mod.armor_hud.on",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "direction_hud": {
    "type": "panel",
    "size": [340, 47.5],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "controls": [
      {
        "direction_pointer": {
          "type": "label",
          "text": "▼",
          "font_scale_factor": 1.2,
          "offset": [0.5, -7]
        }
      },
      {
        "direction_hud_renderer": {
          "type": "custom",
          "renderer": "paper_doll_renderer",
          "size": [40, 40],
          "offset": [0, 1022.5]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "mod.direction_hud.on",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "paperdoll": {
    "type": "panel",
    "size": [20, 40],
    "controls": [
      {
        "hud_player_renderer": {
          "layer": -2,
          "type": "custom",
          "renderer": "hud_player_renderer",
          "size": [20, 20],
          "anchor_to": "bottom_middle",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "mod.paperdoll.activeOnly",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "live_player_renderer": {
          "layer": -2,
          "type": "custom",
          "renderer": "live_player_renderer",
          "size": [20, 20],
          "anchor_to": "bottom_middle",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "mod.paperdoll.always",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}
