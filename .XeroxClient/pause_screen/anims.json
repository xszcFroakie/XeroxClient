{
  "namespace": "pause_animation",

  // diphyrambos scrolling loop

  "diphyrambos_loop_0": {
    "anim_type": "wait",
    "duration": 8,
    "next": "@pause_animation.diphyrambos_loop_1"
  },

  "diphyrambos_loop_1": {
    "anim_type": "offset",
    "from": [0, 0],
    "to": [0, -56],
    "easing": "in_out_cubic",
    "duration": 1.3,
    "next": "@pause_animation.diphyrambos_loop_2"
  },

  "diphyrambos_loop_2": {
    "anim_type": "wait",
    "duration": 8,
    "next": "@pause_animation.diphyrambos_loop_8"
  },

  "diphyrambos_loop_8": {
    "anim_type": "offset",
    "from": [0, -56],
    "to": [0, -112],
    "easing": "in_out_cubic",
    "duration": 1.3,
    "next": "@pause_animation.diphyrambos_loop_4"
  },

  "diphyrambos_loop_4": {
    "anim_type": "wait",
    "duration": 8,
    "next": "@pause_animation.diphyrambos_loop_5"
  },

  "diphyrambos_loop_5": {
    "anim_type": "offset",
    "from": [0, -112],
    "to": [0, 0],
    "easing": "in_out_cubic",
    "duration": 1.3,
    "next": "@pause_animation.diphyrambos_loop_0"
  },

  // main menu animations

  "left_panel_out_animation": {
    "anim_type": "offset",
    "easing": "out_cubic",
    "duration": 0.2,
    "to": [30, 0],
    "from": [50, 0],
    "play_event": "screen.exit_push",
    "end_event": "screen.exit_end"
  },

  "left_panel_out_animation_pop": {
    "anim_type": "offset",
    "easing": "out_cubic",
    "duration": 0.2,
    "to": [30, 0],
    "from": [50, 0],
    "play_event": "screen.exit_pop",
    "end_event": "screen.exit_end"
  },

  "left_panel_enter_animation": {
    "anim_type": "offset",
    "easing": "out_cubic",
    "duration": 0.2,
    "from": [30, 0],
    "to": [50, 0],
    "play_event": "screen.entrance_push",
    "end_event": "screen.entrance_end"
  },

  "left_panel_enter_animation_pop": {
    "anim_type": "offset",
    "easing": "out_cubic",
    "duration": 0.2,
    "from": [30, 0],
    "to": [50, 0],
    "play_event": "screen.entrance_pop",
    "end_event": "screen.entrance_end"
  },

  "paper_doll_out_animation": {
    "anim_type": "size",
    "easing": "out_quad",
    "duration": 0.2,
    "to": ["30%", 0],
    "from": ["30%", "100%"],
    "play_event": "screen.exit_push",
    "end_event": "screen.exit_end"
  },

  "paper_doll_out_animation_pop": {
    "anim_type": "size",
    "easing": "out_quad",
    "duration": 0.2,
    "to": ["30%", 0],
    "from": ["30%", "100%"],
    "play_event": "screen.exit_pop",
    "end_event": "screen.exit_end"
  },

  "paper_doll_enter_animation": {
    "anim_type": "size",
    "easing": "out_quad",
    "duration": 0.2,
    "from": ["30%", 0],
    "to": ["30%", "100%"],
    "play_event": "screen.entrance_push",
    "end_event": "screen.entrance_end"
  },

  "paper_doll_enter_animation_pop": {
    "anim_type": "size",
    "easing": "out_quad",
    "duration": 0.2,
    "from": ["30%", 0],
    "to": ["30%", "100%"],
    "play_event": "screen.entrance_pop",
    "end_event": "screen.entrance_end"
  }
}
