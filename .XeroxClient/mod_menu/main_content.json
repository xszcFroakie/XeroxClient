{
  "namespace": "xc_mod_menu",

  "close_icon": {
    "type": "image",
    "texture": "textures/XeroxClient/arrow/left",
    "anims": "$xeroxclient_button_hover_anims",
    "$xeroxclient_button_hover_anims|default": [],
    "animation_reset_name": "('button.xeroxClient.' + $pressed_button_name)",
    "disable_anim_fast_forward": true,
    "size": [16, 16]
  },

  "close_icon_default_alpha@common_buttons.default_alpha": {
    "ignored": false,
    "from": 0.7,
    "to": 0.9
  },

  "close_icon_hover_alpha@common_buttons.hover_alpha": {
    "ignored": false,
    "to": 0.7,
    "from": 0.9
  },

  "close_toggle@common.toggle": {
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [20, 20],
    "offset": [5, 5],
    "$hover_anim_enabled": true,
    "$pressed_button_name": "button.modMenuClose",
    "$toggle_name": "t",
    "$radio_toggle_group": true,
    "$toggle_group_default_selected": 1,
    "$toggle_group_forced_index": 1,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_select",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.menu_select",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_ok",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_exit",
        "to_button_id": "button.menu_ok",
        "mapping_type": "global"
      },
      {
        "to_button_id": "('button.xeroxClient.' + $pressed_button_name)",
        "mapping_type": "pressed"
      }
    ],
    "controls": [
      {
        "checked@xc_mod_menu.close_icon": {
          "$xeroxclient_button_hover_anims": [
            "@xc_mod_menu.close_icon_default_alpha"
          ]
        }
      },
      {
        "checked_hover@xc_mod_menu.close_icon": {
          "$xeroxclient_button_hover_anims": [
            "@xc_mod_menu.close_icon_hover_alpha"
          ]
        }
      },
      {
        "unchecked@xc_mod_menu.close_icon": {
          "$xeroxclient_button_hover_anims": [
            "@xc_mod_menu.close_icon_default_alpha"
          ]
        }
      },
      {
        "unchecked_hover@xc_mod_menu.close_icon": {
          "$xeroxclient_button_hover_anims": [
            "@xc_mod_menu.close_icon_hover_alpha"
          ]
        }
      }
    ]
  },

  "open_toggle": {
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "offset": [185, "-10%"],
    "size": [30, 30],
    "type": "toggle",
    "toggle_group_default_selected": 1,
    "toggle_name": "t",
    "toggle_group_forced_index": 0,
    "radio_toggle_group": true,
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "mod_menu_open",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#visible"
      }
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.xeroxClient.modMenuOpen",
        "mapping_type": "double_pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.xeroxClient.modMenuOpen",
        "mapping_type": "double_pressed"
      }
    ]
  },

  "scrolling_panel_content": {
    "type": "stack_panel",
    "size": ["100%", "100%cm"],
    "layer": 100,
    "controls": [
      { "hud@xc_mod_menu:hud_page.hud_mod_options": {} },
      { "utils@xc_mod_menu:utils_page.utils_mod_options": {} }
    ]
  },

  "main_content@xc_mod_menu.cfg": {
    "type": "input_panel",
    "size": ["100% - 80px", "100% - 60px"],
    "modal": true,
    "propagate_alpha": true,
    "animation_reset_name": "button.xeroxClient.modMenuOpen",
    "anims": [
      "@mod_menu_animation.mod_menu_enter_size_animation",
      "@mod_menu_animation.mod_menu_enter_alpha_animation"
    ],
    "controls": [
      {
        "outline": {
          "type": "image",
          "texture": "textures/XeroxClient/rounded_corner_border/all8x",
          "alpha": "$xeroxclient_ui_theme_button_hover_alpha",
          "color": "$xeroxclient_ui_theme_button_hover_color",
          "layer": 101
        }
      },
      {
        "main_menu_background": {
          "type": "image",
          "texture": "textures/XeroxClient/rounded_corner/all8x",
          "alpha": "$xeroxclient_ui_theme_menu_background_alpha",
          "color": "$xeroxclient_ui_theme_menu_background_color",
          "layer": 100,
          "controls": [
            {
              "mod_menu_close@xc_mod_menu.close_toggle": {}
            },
            {
              "page_tab_panel": {
                "type": "stack_panel",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "max_size": ["100% - 30px", 20],
                "size": [320, 20],
                "orientation": "horizontal",
                "offset": [25, 5],
                "controls": [
                  {
                    "hud@xc_mod_menu:controls.page_tab": {
                      "$toggle_view_binding_name": "hud_page",
                      "$button_text": "HUD",
                      "$toggle_group_forced_index": 0
                    }
                  },
                  {
                    "utils@xc_mod_menu:controls.page_tab": {
                      "$toggle_view_binding_name": "utils_page",
                      "$button_text": "Utils",
                      "$toggle_group_forced_index": 1
                    }
                  },
                  {
                    "crosshair@xc_mod_menu:controls.page_tab": {
                      "$toggle_view_binding_name": "crosshair_page",
                      "$button_text": "Crosshair",
                      "$toggle_group_forced_index": 2
                    }
                  },
                  {
                    "misc@xc_mod_menu:controls.page_tab": {
                      "$toggle_view_binding_name": "misc_page",
                      "$button_text": "Misc",
                      "$toggle_group_forced_index": 3
                    }
                  }
                ]
              }
            },
            {
              "page_content_panel@xc_modern_scrolling_panel.scrolling_panel": {
                "$scrolling_content": "xc_mod_menu.scrolling_panel_content",
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "offset": [0, -5],
                "size": ["100% - 10px", "100% - 35px"],
                "layer": 101
              }
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "mod_menu_open",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  }
}
