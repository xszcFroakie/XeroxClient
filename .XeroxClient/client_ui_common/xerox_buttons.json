  ///*/ Xerox Client Specific /*///

  "default_alpha_sd@common_buttons.default_alpha": {
    "ignored": false,
    "from": 0.7,
    "to": 0.9
  },

  "hover_alpha_sd@common_buttons.hover_alpha": {
    "ignored": false,
    "to": 0.7,
    "from": 0.9
  },

  "shadow_diffusion_base": {
    "type": "image",
    "texture": "textures/XeroxClient/diffusion2",
    "size": ["100% + 10px", "100% + 10px"],
    "alpha": 0.4,
    "$ignored_default_anims": false,
    "$ignored_hover_anims": false,
    "controls": [
      {
        "icon": {
          "type": "image",
          "texture": "('textures/XeroxClient/' + $icon_folder + $button_icon)",
          "$icon_folder|default": "icon/",
          "size": ["100% - 20px", "100%x"],
          "layer": 1,
          "alpha": "$xeroxclient_button_alpha",
          "color": "$icon_color",
          "$icon_color|default": [1.0, 1.0, 1.0],
          "anims": "$xeroxclient_button_hover_anims",
          "$xeroxclient_button_hover_anims|default": [],
          "animation_reset_name": "('button.xeroxClient.' + $pressed_button_name)",
          "disable_anim_fast_forward": true,
          "ignored": "($button_icon = 'none')",
          "controls": [
            {
              "text": {
                "type": "label",
                "text": "$button_text",
                "size": ["default", "default"],
                "max_size": ["100% + 25px", 10],
                "anchor_from": "bottom_middle",
                "anchor_to": "top_middle",
                "font_type": "$global_font_type",
                "backup_font_type": "$global_font_type_backup",
                "font_scale_factor": 0.7,
                "text_alignment": "center",
                "alpha": 0.9,
                "color": "$text_color",
                "$text_color|default": [0.7, 0.7, 0.7],
                "layer": 2,
                "ignored": "($button_text = '')"
              }
            }
          ]
        }
      }
    ]
  },

  "shadow_diff@common.button": {
    "$button_icon|default": "none",
    "$button_text|default": "",
    "$hover_anim_enabled": true,
    "$button_hover_tip|default": false,
    "$button_hover_tip_text|default": "xc.tip.press2x",
    "$button_hover_tip_text_binding|default": [],
    "controls": [
      {
        "default@common_buttons.shadow_diffusion_base": {
          "$xeroxclient_button_alpha": 0.9,
          "$xeroxclient_button_hover_anims": [
            "@common_buttons.default_alpha_sd"
          ]
        }
      },
      {
        "hover@common_buttons.shadow_diffusion_base": {
          "$xeroxclient_button_alpha": 0.7,
          "$xeroxclient_button_hover_anims": ["@common_buttons.hover_alpha_sd"]
        }
      },
      {
        "pressed@common_buttons.shadow_diffusion_base": {
          "$xeroxclient_button_alpha": 0.7
        }
      },
      {
        "hover_tip@xc_modern_container:classic_common.custom_hover_text": {
          "$hover_text": "$button_hover_tip_text",
          "$hover_text_bindings": "$button_hover_tip_text_binding",
          "ignored": "(not $button_hover_tip)"
        }
      }
    ]
  }
}
